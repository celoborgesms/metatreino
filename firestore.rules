rules_version = '2';

// =============================================================
// METATREINO — REGRAS DO FIRESTORE (2027.1 Beta 48)
// Beta 48: coleção "cupons" e resgate de cupom em usuariosAutorizados (só junto com um cupom livre).
// Beta 46: coleção "familias" (alimentação da casa). Nenhuma outra permissão mudou.
// Beta 43: coleção "diagnosticoAcesso" (falhas técnicas de acesso, sem
// e-mail nem UID; só o principal lê). Nenhuma outra permissão mudou —
// a leitura de usuariosAutorizados continua exigindo e-mail verificado.
// Beta 40: planos Gratuito/Premium. Conta nova cria o próprio Teste Premium
// (uma vez só, data do servidor); só administradores mudam plano ou suspendem.
// Novo: adminLog (registro das ações do painel). Os administradores continuam
// sendo conferidos pela coleção "admins" em cada pedido (sem custom claims):
// remover o documento tira o acesso na mesma hora, no servidor.
// Beta 35: ao excluir a conta, a pessoa apaga também os documentos dos
// outros logins dela (mesmo e-mail verificado); a participação nos
// desafios fica no documento de dados unificado.
// Beta 34: a mesma pessoa (mesmo e-mail VERIFICADO) acessa o mesmo
// documento de dados com qualquer forma de login (Google ou e-mail e
// senha geram UIDs diferentes). Coleção nova "contas" (vínculo e-mail →
// documento) e "parceiros" (créditos dos vídeos, só administradores).
// Beta 33: o aluno não consegue mais gravar no próprio documento um
// e-mail que não é o dele (antes podia aparecer no painel com o
// e-mail de outra pessoa). Nada mais mudou nas permissões.
// Onde colar: Firebase Console → Firestore Database → Regras
// Nenhuma coleção é pública (exceto a leitura de config/contato,
// que já era pública e é usada na tela de login).
// =============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // IDENTIFICACAO E PERMISSOES
    // =========================================================

    function signedIn() {
      return request.auth != null;
    }

    function userEmail() {
      return signedIn() && request.auth.token.email != null
        ? request.auth.token.email.lower()
        : "";
    }

    // ADMINISTRADOR PRINCIPAL (DONO DO METATREINO)
    // Reconhecido pelo UID da conta OU pelo e-mail do dono com
    // e-mail VERIFICADO (cobre o login com Google e com e-mail/senha,
    // que geram UIDs diferentes). Ninguem consegue "verificar" um
    // e-mail que nao e seu, entao isso nao abre brecha.
    function isOwner() {
      return signedIn() && (
        request.auth.uid == "CJpmKyaTYtgR9I7FpigMPuXwICG2"
        || (
          request.auth.token.email != null
          && request.auth.token.email.lower() == "celoborgesms@gmail.com"
          && request.auth.token.email_verified == true
        )
      );
    }

    // ADMINISTRADOR PRINCIPAL OU ADMINISTRADOR SECUNDARIO ATIVO
    function isAdmin() {
      return isOwner()
        || (
          signedIn()
          && request.auth.token.email != null
          && exists(/databases/$(database)/documents/admins/$(userEmail()))
          && get(/databases/$(database)/documents/admins/$(userEmail())).data.ativo == true
        );
    }

    function isOwnerUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }


    // =========================================================
    // USUARIOS E SEUS DADOS
    // (aluno: so os proprios dados · administradores: todos)
    // =========================================================

    // e-mail que dá para confiar: verificado, ou o usuário interno (sem e-mail real)
    function emailConfiavel() {
      return signedIn() && request.auth.token.email != null && (
        request.auth.token.email_verified == true
        || userEmail().matches('.*@aluno[.]metatreino[.]app')
      );
    }

    // documento de dados vinculado ao e-mail desta pessoa (contas/{email}.uid)
    function contaVinculada(userId) {
      return emailConfiavel()
        && exists(/databases/$(database)/documents/contas/$(userEmail()))
        && get(/databases/$(database)/documents/contas/$(userEmail())).data.uid == userId;
    }

    // documento antigo da mesma pessoa (outro login, mesmo e-mail): só leitura, para juntar
    function mesmoEmail(userId) {
      return emailConfiavel()
        && exists(/databases/$(database)/documents/usuarios/$(userId))
        && get(/databases/$(database)/documents/usuarios/$(userId)).data.email.lower() == userEmail();
    }

    // o campo "email" do documento do aluno precisa ser o e-mail da própria conta
    function emailDoDocOk() {
      return !('email' in request.resource.data)
        || request.resource.data.email == null
        || (emailConfiavel() && request.resource.data.email.lower() == userEmail());
    }

    // Beta 42: conta excluída pelo administrador (marca permanente). O app antigo da pessoa, se ainda
    // estiver logado, não consegue recriar os dados nem ganhar um novo teste Premium.
    function contaExcluida() {
      return signedIn() && request.auth.token.email != null
        && exists(/databases/$(database)/documents/contasExcluidas/$(userEmail()));
    }

    match /usuarios/{userId} {
      allow get:
        if isOwnerUser(userId) || contaVinculada(userId) || isAdmin()
          || (emailConfiavel() && resource.data.email == request.auth.token.email);
      // procurar os documentos do próprio e-mail (unificação) ou, para admins, a lista toda
      allow list:
        if isAdmin() || (emailConfiavel() && resource.data.email == request.auth.token.email);
      allow create, update:
        if ((isOwnerUser(userId) || contaVinculada(userId)) && emailDoDocOk() && !contaExcluida()) || isAdmin();
      // Apagar: o proprio aluno (excluir conta / comecar do zero) ou o
      // administrador principal (limpeza de ex-alunos). Secundario nao apaga.
      allow delete:
        if isOwnerUser(userId) || contaVinculada(userId) || mesmoEmail(userId) || isOwner();

      // Inclui o arquivo anual (usuarios/{uid}/arquivo/{ano-semestre}).
      match /{subdocumentos=**} {
        allow read:
          if isOwnerUser(userId) || contaVinculada(userId) || mesmoEmail(userId) || isAdmin();
        allow create, update:
          if ((isOwnerUser(userId) || contaVinculada(userId)) && !contaExcluida()) || isAdmin();
        allow delete:
          if isOwnerUser(userId) || contaVinculada(userId) || mesmoEmail(userId) || isOwner();
      }
    }


    // =========================================================
    // CONTAS (Beta 34): e-mail → documento de dados único da pessoa
    // Só a própria pessoa (e-mail verificado) cria/troca o vínculo, e
    // só pode apontar para o próprio login ou para um documento que
    // já é do mesmo e-mail.
    // =========================================================

    match /contas/{emailDoc} {
      allow read: if isAdmin() || (emailConfiavel() && userEmail() == emailDoc);
      allow create, update: if emailConfiavel() && userEmail() == emailDoc
        && request.resource.data.uid is string
        && (request.resource.data.uid == request.auth.uid || mesmoEmail(request.resource.data.uid));
      allow delete: if (emailConfiavel() && userEmail() == emailDoc) || isOwner();
    }

    // PARCEIROS (Beta 34): dados completos dos criadores dos vídeos
    // (inclui contato privado). Só administradores. O que o aluno vê
    // fica copiado no documento do vídeo, só com o que o admin liberou.
    match /parceiros/{parceiroDoc} {
      allow read, create, update, delete: if isAdmin();
    }

    // =========================================================
    // USUARIOS AUTORIZADOS (liberacao de acesso dos alunos)
    // =========================================================

    // Beta 40: este documento é o PLANO da pessoa (Gratuito, Teste Premium, Premium ou conta
    // suspensa). Sem documento = Gratuito. O aluno só lê o próprio e só pode CRIAR uma única vez
    // o próprio Teste Premium: plano 'teste', data do servidor (não dá para "voltar no tempo"),
    // e-mail verificado (contas de usuário sem e-mail não ganham teste). Não pode alterar nem apagar.
    // Administrador não altera o próprio documento (só o principal), para ninguém se dar Premium.
    match /usuariosAutorizados/{emailDoc} {

      allow read: if isAdmin() || (
        signedIn()
        && request.auth.token.email != null
        && userEmail() == emailDoc
        && (
          request.auth.token.email_verified == true
          || emailDoc.matches('.*@aluno[.]metatreino[.]app')
        )
      );

      // Beta 48: resgate de cupom. O aluno só vira Premium se, NA MESMA gravação, marcar como usado por
      // ele um cupom que estava livre e dentro do prazo, e com no máximo os dias daquele cupom (somados ao
      // prazo que ele já tinha, se ainda não acabou). Conta suspensa não usa cupom.
      function cupomRef(){ return /databases/$(database)/documents/cupons/$(request.resource.data.cupom); }
      function resgateBase(){
        return signedIn()
          && request.auth.token.email_verified == true
          && userEmail() == emailDoc
          && !contaExcluida()
          && request.resource.data.plano == 'premium'
          && request.resource.data.cupom is string
          && request.resource.data.cupom.size() >= 6 && request.resource.data.cupom.size() <= 12
          && request.resource.data.cupomEm == request.time
          && request.resource.data.premiumAte is number
          && exists(cupomRef())
          && get(cupomRef()).data.usadoPor == null
          && getAfter(cupomRef()).data.usadoPor == request.auth.uid;
      }
      // prazo novo ≤ início + dias do cupom (+5 min de folga para o relógio do celular)
      function ateCabe(inicio){ return request.resource.data.premiumAte <= inicio + get(cupomRef()).data.dias * 86400000 + 300000; }

      allow create: if (isAdmin() && (isOwner() || emailDoc != userEmail())) || (
        signedIn()
        && request.auth.token.email_verified == true
        && userEmail() == emailDoc
        && request.resource.data.keys().hasOnly(['plano', 'testeInicio', 'origem', 'name'])
        && request.resource.data.plano == 'teste'
        && request.resource.data.testeInicio == request.time
        && !contaExcluida()
      ) || (
        resgateBase()
        && request.resource.data.keys().hasOnly(['plano', 'premiumAte', 'cupom', 'cupomEm', 'name'])
        && ateCabe(request.time.toMillis())
      );

      allow update: if (isAdmin() && (isOwner() || emailDoc != userEmail())) || (
        resgateBase()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['plano', 'premiumAte', 'cupom', 'cupomEm'])
        && resource.data.get('bloqueado', false) != true
        && (
          ateCabe(request.time.toMillis())
          || (resource.data.get('premiumAte', null) is number && ateCabe(resource.data.premiumAte))
          || (resource.data.get('premiumAte', null) is timestamp && ateCabe(resource.data.premiumAte.toMillis()))
          || (resource.data.get('plano', '') == 'teste' && resource.data.get('testeInicio', null) is timestamp
              && ateCabe(resource.data.testeInicio.toMillis() + 30 * 86400000))
          || (resource.data.get('expiresAt', null) is number && ateCabe(resource.data.expiresAt))
          || (resource.data.get('expiresAt', null) is timestamp && ateCabe(resource.data.expiresAt.toMillis()))
        )
      );

      allow delete: if isAdmin() && (isOwner() || emailDoc != userEmail());
    }

    // Beta 48: cupons de Premium para divulgação. Administradores criam, listam e apagam os livres.
    // Quem tem o código (e-mail verificado) consulta só aquele cupom e o marca como usado por si mesmo,
    // uma única vez, dentro do prazo — sempre junto com a liberação do próprio Premium (regra acima).
    match /cupons/{cupomDoc} {
      allow get: if isAdmin() || (signedIn() && request.auth.token.email_verified == true);
      allow list: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.usadoPor == null
        && request.resource.data.dias is int && request.resource.data.dias >= 1 && request.resource.data.dias <= 365
        && cupomDoc.size() >= 6 && cupomDoc.size() <= 12;
      allow delete: if isAdmin() && (resource.data.usadoPor == null || isOwner());
      allow update: if signedIn()
        && request.auth.token.email_verified == true
        && resource.data.usadoPor == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usadoPor', 'usadoEm'])
        && request.resource.data.usadoPor == request.auth.uid
        && request.resource.data.usadoEm == request.time
        && (resource.data.get('validoAte', null) == null || request.time.toMillis() <= resource.data.validoAte)
        && getAfter(/databases/$(database)/documents/usuariosAutorizados/$(userEmail())).data.cupom == cupomDoc;
    }

    // Beta 42: contas excluídas (marca permanente). Só o administrador principal cria, libera (apaga)
    // e consulta a lista; a própria pessoa lê o seu (o app mostra a conta como encerrada).
    match /contasExcluidas/{emailDoc} {
      allow read: if isOwner() || (signedIn() && request.auth.token.email != null && userEmail() == emailDoc);
      allow create, update, delete: if isOwner() && emailDoc != userEmail();
    }

    // Beta 42: liberação excepcional de restauração de backup (suporte), por e-mail e com prazo.
    // Administradores liberam (nunca para si mesmos, exceto o principal); a pessoa só lê a sua.
    match /liberacoesBackup/{emailDoc} {
      allow read: if isAdmin() || (emailConfiavel() && userEmail() == emailDoc);
      allow create, update, delete: if isAdmin() && (isOwner() || emailDoc != userEmail());
    }

    // Beta 40: registro das ações administrativas (quem fez, o quê, em quem, quando).
    // Administradores criam; só o principal lê. Ninguém altera nem apaga um registro.
    match /adminLog/{logDoc} {
      allow create: if isAdmin()
        && request.resource.data.por == userEmail()
        && request.resource.data.em == request.time;
      allow read: if isOwner();
      allow update, delete: if false;
    }

    // Beta 46: alimentação da casa (2 a 6 pessoas). Só os membros leem e alteram. Para entrar, a pessoa
    // precisa do código (o id do documento) e só pode acrescentar a si mesma, com apelido e perfil próprios.
    // Para sair, só tira a si mesma. O documento guarda apelidos, restrições, proporção da porção e o
    // registro das refeições da casa — nada de peso, idade ou e-mail.
    match /familias/{famId} {
      function famMembro(){ return signedIn() && request.auth.uid in resource.data.membros; }
      function famDepois(){ return request.resource.data; }
      allow read: if famMembro() || isOwner();
      allow create: if signedIn() && famId.size() == 6
        && famDepois().membros == [request.auth.uid] && famDepois().dono == request.auth.uid;
      allow update: if signedIn() && famDepois().membros.size() <= 6 && (
        // membro: mexe no cardápio e no registro; a lista de membros fica igual (ou ele sai)
        (famMembro() && (famDepois().membros.hasAll(resource.data.membros)
                         ? famDepois().membros.size() == resource.data.membros.size()
                         : resource.data.membros.removeAll(famDepois().membros).hasOnly([request.auth.uid])))
        // quem entra: só se acrescenta e só escreve o próprio apelido/perfil
        || (!(request.auth.uid in resource.data.membros)
            && famDepois().membros.hasAll(resource.data.membros)
            && famDepois().membros.removeAll(resource.data.membros).hasOnly([request.auth.uid])
            && famDepois().diff(resource.data).affectedKeys().hasOnly(['membros','nomes','perfis'])
            && famDepois().dono == resource.data.dono)
      );
      allow delete: if (famMembro() && resource.data.membros.size() == 1) || isOwner();
    }

    // Beta 43: diagnóstico de falhas ao verificar o acesso. Qualquer conta
    // logada registra a PRÓPRIA falha, só com campos técnicos curtos (sem
    // e-mail, sem UID, sem dados de treino). "conta" é um resumo (hash) do
    // e-mail, que o principal compara com a lista de alunos no próprio
    // aparelho. Só o principal lê e apaga; ninguém altera.
    match /diagnosticoAcesso/{diagDoc} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['codigo','etapa','versao','em','plataforma','emailVerificado','tokenVerificado','provedor','conta','online'])
        && request.resource.data.em == request.time
        && request.resource.data.codigo is string && request.resource.data.codigo.size() <= 80
        && request.resource.data.etapa is string && request.resource.data.etapa.size() <= 40
        && (!('versao' in request.resource.data) || (request.resource.data.versao is string && request.resource.data.versao.size() <= 30))
        && (!('plataforma' in request.resource.data) || (request.resource.data.plataforma is string && request.resource.data.plataforma.size() <= 40))
        && (!('provedor' in request.resource.data) || (request.resource.data.provedor is string && request.resource.data.provedor.size() <= 30))
        && (!('conta' in request.resource.data) || (request.resource.data.conta is string && request.resource.data.conta.size() <= 16));
      allow read, delete: if isOwner();
      allow update: if false;
    }


    // =========================================================
    // ADMINISTRADORES
    // - O principal le a lista inteira e e o UNICO que concede,
    //   altera ou revoga administradores.
    // - Cada pessoa le somente o proprio documento (o app usa isso
    //   para saber se a conta e administradora).
    // - Administrador secundario nao consegue se promover, promover
    //   outra pessoa nem mexer no documento do dono.
    // =========================================================

    match /admins/{emailDoc} {

      allow read: if isOwner() || (
        signedIn()
        && request.auth.token.email != null
        && userEmail() == emailDoc
      );

      allow create, update, delete: if isOwner()
        && emailDoc != "celoborgesms@gmail.com";
    }


    // =========================================================
    // VIDEOS DE EXERCICIOS
    // (Beta 13: TODOS os administradores voltam a adicionar,
    //  editar e remover links de video)
    // =========================================================

    match /videosExercicios/{exercicioDoc} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // VIDEOS REPORTADOS PELOS ALUNOS
    // 1 documento por exercicio (sem dados pessoais) + 1 relato
    // por aluno na subcolecao "relatos".
    // =========================================================

    match /videosReportados/{exercicioDoc} {

      // Aluno consulta o documento do exercicio (para nao contar 2x).
      allow get: if signedIn();

      // Somente administradores listam as ocorrencias.
      allow list: if isAdmin();

      // Aluno cria a ocorrencia sempre como "pendente", contando 1.
      allow create: if isAdmin() || (
        signedIn()
        && request.resource.data.status == 'pendente'
        && request.resource.data.contagem == 1
        && request.resource.data.ciclo == 1
      );

      // Aluno so reabre como "pendente", soma no maximo 1 por vez,
      // nao mexe no ciclo e so altera os campos da denuncia.
      // Resolver (status "resolvido"): qualquer administrador.
      allow update: if isAdmin() || (
        signedIn()
        && request.resource.data.status == 'pendente'
        && request.resource.data.ciclo == resource.data.ciclo
        && request.resource.data.contagem <= resource.data.contagem + 1
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['exId', 'exercicio', 'grupo', 'url', 'videoId',
                       'status', 'ultimoEm', 'ultimoMotivo', 'contagem'])
      );

      allow delete: if isAdmin();

      match /relatos/{userId} {
        allow get: if isOwnerUser(userId) || isAdmin();
        allow list: if isAdmin();
        allow create, update: if isOwnerUser(userId);
        allow delete: if isAdmin();
      }
    }


    // =========================================================
    // EXERCICIOS PERSONALIZADOS
    // =========================================================

    match /exerciciosCustom/{exercicioDoc} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // CALISTENIA (exercicios extras/ajustes e modelos de plano)
    // =========================================================

    match /caliExercicios/{exercicioDoc} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /caliModelos/{modeloDoc} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // DESAFIOS TEMATICOS
    // =========================================================

    match /desafiosTematicos/{desafioDoc} {

      // Todos os alunos logados veem os desafios.
      allow read: if signedIn();

      // Administradores criam, editam ou desativam desafios.
      allow create, update, delete: if isAdmin();

      // Participacao de cada aluno: cada um grava so a propria.
      match /participantes/{userId} {
        allow get: if isOwnerUser(userId) || contaVinculada(userId) || isAdmin();
        allow list: if isAdmin();
        allow create, update: if isOwnerUser(userId) || contaVinculada(userId);
        // O proprio aluno ou o administrador principal (limpeza de ex-alunos).
        allow delete: if isOwnerUser(userId) || contaVinculada(userId) || isOwner();
      }
    }


    // =========================================================
    // CONFIGURACOES
    // =========================================================

    // Contato do treinador: leitura publica (tela de login).
    match /config/contato {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // CONQUISTA ESPECIAL: exclusiva do administrador principal.
    // Os alunos logados precisam LER (o app confere se a conquista
    // e para eles), mas so o dono cria, edita ou apaga.
    match /config/specialAward {
      allow read: if signedIn();
      allow create, update, delete: if isOwner();
    }

    // Demais configuracoes (mural, calistenia...).
    match /config/{configDoc} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin() && configDoc != "specialAward";
    }


    // =========================================================
    // MENSAGENS DOS ALUNOS (sugestoes, problemas e perguntas
    // enviadas pelo Meta Assistente)
    // =========================================================

    match /perguntasNaoRespondidas/{docId} {

      // Qualquer aluno logado pode enviar.
      allow create: if signedIn();

      // Quando outro aluno envia a MESMA mensagem, o app soma +1 no
      // documento existente. O aluno so pode mexer nesses campos,
      // somar no maximo 1, sem trocar o texto e assinando com o
      // proprio e-mail. Nao consegue ler nem apagar nada.
      allow update: if isAdmin() || (
        signedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['texto', 'tipo', 'modulo', 'ultimoEmail', 'ultimoNome',
                       'ultimaVersao', 'ultimo', 'visto', 'n', 'versoes'])
        && request.resource.data.texto == resource.data.texto
        && request.resource.data.ultimoEmail.lower() == userEmail()
        && request.resource.data.n <= resource.data.get('n', 0) + 1
      );

      // Somente administradores visualizam e apagam.
      allow read: if isAdmin();
      allow delete: if isAdmin();
    }


    // =========================================================
    // BLOQUEIO DE COLECOES NAO PREVISTAS
    // =========================================================

    match /{documento=**} {
      allow read, write: if false;
    }

  }
}
