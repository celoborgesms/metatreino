rules_version = '2';
// =====================================================================
// MetaTreino 2027.1 Beta 12 — regras do Firestore (PROPOSTA)
//
// IMPORTANTE: compare com as regras que estão publicadas hoje no console antes de
// substituir. Se preferir a mudança mínima, copie só o bloco "desafiosTematicos"
// e o bloco "admins" (Beta 10) e "videosReportados" + a mudança em "videosExercicios" (Beta 11).
//
// Princípios:
//  • o aluno só lê e grava os PRÓPRIOS dados;
//  • administradores autorizados (coleção admins, ativo == true) gerenciam alunos,
//    exercícios e vídeos;
//  • só o administrador principal cria desafios temáticos e mexe em permissões —
//    verificado aqui no servidor, não só na tela.
// =====================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn()   { return request.auth != null; }
    function myEmail()    { return signedIn() && request.auth.token.email != null ? request.auth.token.email.lower() : ''; }
    function isPrincipal(){ return myEmail() == 'celoborgesms@gmail.com'; }
    function isAdmin()    {
      return isPrincipal() ||
        (signedIn() && exists(/databases/$(database)/documents/admins/$(myEmail())) &&
         get(/databases/$(database)/documents/admins/$(myEmail())).data.ativo == true);
    }

    // ---- dados do aluno (estadoApp) ----
    match /usuarios/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update, delete: if signedIn() && request.auth.uid == uid;
    }

    // ---- liberação de acesso ----
    match /usuariosAutorizados/{email} {
      allow get: if signedIn() && (myEmail() == email || isAdmin());
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // ---- administradores: o próprio usuário confere se é admin; só o principal altera ----
    match /admins/{email} {
      allow get: if signedIn() && (myEmail() == email || isAdmin());
      allow list: if isPrincipal();
      allow write: if isPrincipal() && email != 'celoborgesms@gmail.com';
    }

    // ---- configurações (contato aparece na tela de login, antes de entrar) ----
    match /config/{doc} {
      allow read: if true;
      allow write: if doc == 'specialAward' ? isPrincipal() : isAdmin();
    }

    // ---- catálogo ----
    match /exerciciosCustom/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    // Beta 11: só o administrador principal mantém os links dos vídeos (pedido do dono do app)
    match /videosExercicios/{id} {
      allow read: if signedIn();
      allow write: if isPrincipal();
    }

    // ---- NOVO (Beta 11): vídeos reportados pelos alunos ----
    // 1 documento por exercício (agrupa denúncias, sem dados pessoais) + 1 relato por aluno.
    match /videosReportados/{exId} {
      allow get: if signedIn();
      allow list: if isAdmin();
      // aluno: só cria/reabre como "pendente", soma no máximo 1 por vez e não mexe no ciclo
      allow create: if signedIn() && request.resource.data.status == 'pendente'
                    && request.resource.data.contagem == 1 && request.resource.data.ciclo == 1;
      allow update: if isPrincipal() || (signedIn()
                    && request.resource.data.status == 'pendente'
                    && request.resource.data.ciclo == resource.data.ciclo
                    && request.resource.data.contagem <= resource.data.contagem + 1
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['exId','exercicio','grupo','url','videoId','status','ultimoEm','ultimoMotivo','contagem']));
      allow delete: if isPrincipal();

      match /relatos/{uid} {
        allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
        allow list: if isAdmin();
        allow create, update: if signedIn() && request.auth.uid == uid;
        allow delete: if isPrincipal();
      }
    }

    // ---- NOVO (Beta 12): calistenia — exercícios extras/ajustes e modelos de plano ----
    match /caliExercicios/{id} {
      allow read: if signedIn();
      allow write: if isPrincipal();
    }
    match /caliModelos/{id} {
      allow read: if signedIn();
      allow write: if isPrincipal();
    }

    // ---- perguntas que o assistente não soube responder (feedback) ----
    match /perguntasNaoRespondidas/{id} {
      allow get: if signedIn();
      allow create, update: if signedIn();
      allow list, delete: if isAdmin();
    }

    // ---- NOVO (Beta 10): desafios temáticos ----
    match /desafiosTematicos/{eventoId} {
      allow read: if signedIn();
      allow write: if isPrincipal();

      // participação real de cada aluno (só ele grava a própria)
      match /participantes/{uid} {
        allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
        allow list: if isAdmin();
        allow create, update, delete: if signedIn() && request.auth.uid == uid;
      }
    }
  }
}
